APP_NAME="Defect Tracking System"
DEBUG=False
SECRET_KEY=change-me-to-long-random-secret
DATABASE_URL=sqlite:///./defect_tracker.db
SESSION_COOKIE_NAME=dts_session
SESSION_EXPIRE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
CORS_ORIGINS=[]
TRUSTED_HOSTS=["*"]
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# Feature flags Phases 2-3 (documented defaults; not sole security boundary)
FEATURE_CUSTOM_WORKFLOWS=False
FEATURE_CUSTOM_FIELDS=True
FEATURE_LINKS=True
FEATURE_BULK_OPS=True
FEATURE_NOTIFICATIONS=True
FEATURE_SAVED_VIEWS=True
FEATURE_MENTIONS=True
